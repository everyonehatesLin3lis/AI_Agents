# Copy to .env and fill in. Never commit .env.

# LLM provider. OpenRouter is used when its key is set, otherwise OpenAI directly.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gcp-review-agent

# Optional. Without it the agent uses tools/prices_static.json and says so in the report.
GCP_BILLING_API_KEY=

# Optional overrides (defaults live in agent/config.py)
# REVIEW_MODEL=openai/gpt-6-luna
# REVIEW_TEMPERATURE=0        # leave empty to not send the parameter
# REVIEW_SEED=42              # leave empty to not send the parameter
# REVIEW_DATA_DIR=data
